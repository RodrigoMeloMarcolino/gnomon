# Ambiente local de desenvolvimento — copie para .env apenas se precisar
# sobrescrever algum default. NUNCA commitar o .env (ver .gitignore).
# Em prod, todos os valores devem vir de variáveis de ambiente reais (RNF-08).

# PostgreSQL (container + API)
POSTGRES_DB=gnomon
POSTGRES_USER=gnomon
POSTGRES_PASSWORD=gnomon
# Porta publicada no host para o postgres do compose (mude se 5432 estiver ocupada)
POSTGRES_PORT=5432

# API → banco (defaults do profile local já apontam para localhost)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gnomon
DB_USER=gnomon
DB_PASSWORD=gnomon
# DB_URL só é exigida no profile prod (jdbc:postgresql://host:5432/gnomon)
# DB_URL=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Keycloak (admin console local — apenas dev)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Porta publicada no host para o keycloak do compose
KEYCLOAK_PORT=8081
# Issuer do realm — usado pela API a partir da fase 01 (resource server JWT)
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/gnomon

# API
SERVER_PORT=8080
# Porta publicada no host para o serviço api do compose (profile full)
API_PORT=8080

# Observabilidade (fase 06)
LOG_LEVEL=INFO
# Local usa console por padrão; nos demais perfis o formatter JSON é habilitado.
LOG_FORMAT=console
OTEL_SERVICE_NAME=gnomon
# OTLP é opcional: sem endpoint, os logs continuam apenas no stdout.
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# OTEL_EXPORTER_OTLP_LOGS_TIMEOUT=5s
# OTEL_BLRP_MAX_QUEUE_SIZE=2048
# OTEL_BLRP_MAX_EXPORT_BATCH_SIZE=512
