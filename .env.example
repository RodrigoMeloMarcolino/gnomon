# Copie com `pnpm local:setup`; os marcadores abaixo nunca devem ser usados como credenciais.
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000

POSTGRES_USER=gnomon
POSTGRES_DB=gnomon
POSTGRES_PORT=5432
POSTGRES_PASSWORD=__GENERATED_POSTGRES_PASSWORD__
DATABASE_URL=postgres://gnomon:__URL_ENCODED_POSTGRES_PASSWORD__@localhost:5432/gnomon
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10

REDIS_PORT=6379
REDIS_PASSWORD=__GENERATED_REDIS_PASSWORD__
REDIS_URL=redis://:__URL_ENCODED_REDIS_PASSWORD__@localhost:6379

KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=__GENERATED_KEYCLOAK_PASSWORD__
KEYCLOAK_ISSUER=http://localhost:8180/realms/gnomon-local
KEYCLOAK_AUDIENCE=gnomon-api

OTEL_SERVICE_NAME=gnomon
OTEL_EXPORTER_OTLP_ENDPOINT=
